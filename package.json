{
  "name": "cb-x-deck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --env-file-if-exists=.env --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "migrate": "bash scripts/apply-migrations.sh",
    "migrate:staging": "bash scripts/apply-migrations.sh .env.staging",
    "setup:staging": "node --import tsx --env-file=.env.staging scripts/setup-staging.ts",
    "seed:staging": "node --import tsx --env-file=.env.staging scripts/seed-staging.ts",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "smoke:external": "node --import tsx scripts/smoke-external-api.ts",
    "smoke:getxapi": "node --import tsx --env-file-if-exists=.env scripts/smoke-getxapi.ts",
    "smoke:suggest": "node --import tsx --env-file-if-exists=.env scripts/smoke-suggest.ts",
    "smoke:exa": "node --import tsx --env-file-if-exists=.env scripts/smoke-exa.ts",
    "smoke:translate": "node --import tsx --env-file-if-exists=.env scripts/smoke-translate.ts",
    "smoke:generate": "node --import tsx --env-file-if-exists=.env scripts/smoke-generate.ts",
    "smoke:shortio": "node --import tsx --env-file-if-exists=.env scripts/smoke-shortio.ts",
    "backfill:quoted": "node --import tsx --env-file-if-exists=.env scripts/backfill-quoted.ts",
    "seed:staging:slack": "node --import tsx --env-file=.env.staging scripts/seed-staging-slack.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.40.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
